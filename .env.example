# Port the server listens on
PORT=3000

# Long random string used to sign login cookies. CHANGE THIS.
JWT_SECRET=change-me-to-a-long-random-string

# Platform owner account (created on first start if it does not exist)
ADMIN_EMAIL=admin@salem.app
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Salem Admin

# PostgreSQL connection string (Neon, Supabase, Render Postgres…)
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# SSL is chosen automatically (on for hosted databases, off for localhost and Render's internal URL).
# Force it with DATABASE_SSL=true or DATABASE_SSL=false if needed.
# DATABASE_SSL=

# Delete screenshots older than this many days (privacy). 0 = keep forever.
SNAPSHOT_RETENTION_DAYS=30

# Minutes a driver has to accept a monitoring request before it expires
REQUEST_EXPIRY_MIN=15

# Set to true when running behind HTTPS (Render, Railway, Nginx + SSL)
COOKIE_SECURE=false

# ---------------- Email notifications (optional) ----------------
# New registration -> admin; request received / approved / rejected -> company.
# Without these, Salem works normally and just skips the emails.

# Public address used in email links
APP_URL=https://salem-kxe4.onrender.com

# Sender shown on emails. With Resend it must be on a domain you verified there.
EMAIL_FROM=Salem <no-reply@yourdomain.sa>

# Who receives "new company registered" alerts (comma-separated). Defaults to ADMIN_EMAIL.
ADMIN_NOTIFY_EMAIL=

# Option 1 (recommended on Render): Resend — https://resend.com → API Keys
RESEND_API_KEY=

# Option 2: any SMTP account (Gmail with an app password, Outlook, Zoho, your host…)
# Leave RESEND_API_KEY empty to use this. Some hosts (e.g. Render free) block SMTP ports.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465
SMTP_SECURE=false
